# Template for Coinbase Developer Platform (CDP) credentials.
#
# To use this template, copy this file, rename it to "api.env", and fill in the values.
# agents/constants/cdp.py loads this file specifically via `load_dotenv("api.env")`.
#
# Get these from the CDP portal: https://portal.cdp.coinbase.com/

CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=
