# Template for Backend (FastAPI) environment variables.
#
# To use this template, copy this file, rename it to ".env", and fill in the values.
# main.py loads this file automatically via `load_dotenv(override=True)`.
#
# NOTE: Coinbase Developer Platform (CDP) credentials are loaded from a separate
# "api.env" file (see agents/constants/cdp.py). Copy api.env.example -> api.env
# for those instead of putting them here.

# OpenAI API key, used by the LangChain/LangGraph agents (agents/constants/ai_models.py)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Tavily search API key, used by the Research Analyst agent's web search tool
# (agents/tools/search_tools.py). Get one at https://tavily.com
TAVILY_API_KEY=

# Replicate API token, used for AI image generation (agents/utils/image_generation.py)
# Get one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
