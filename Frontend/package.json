{
  "name": "chainfusion-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "ChainFusion frontend: Next.js app + Hardhat contracts for bridging Web2 apps to Web3 with AI agents.",
  "author": "bharat3645",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bharat3645/ChainFusion.git",
    "directory": "Frontend"
  },
  "homepage": "https://github.com/bharat3645/ChainFusion#readme",
  "bugs": {
    "url": "https://github.com/bharat3645/ChainFusion/issues"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "account": "yarn workspace @chainfusion/hardhat account",
    "chain": "yarn workspace @chainfusion/hardhat chain",
    "compile": "yarn workspace @chainfusion/hardhat compile",
    "deploy": "yarn workspace @chainfusion/hardhat deploy",
    "flatten": "yarn workspace @chainfusion/hardhat flatten",
    "fork": "yarn workspace @chainfusion/hardhat fork",
    "format": "yarn next:format && yarn hardhat:format",
    "generate": "yarn workspace @chainfusion/hardhat generate",
    "hardhat-verify": "yarn workspace @chainfusion/hardhat hardhat-verify",
    "hardhat:format": "yarn workspace @chainfusion/hardhat format",
    "hardhat:lint": "yarn workspace @chainfusion/hardhat lint",
    "hardhat:lint-staged": "yarn workspace @chainfusion/hardhat lint-staged",
    "hardhat:test": "yarn workspace @chainfusion/hardhat test",
    "postinstall": "husky install",
    "next:build": "yarn workspace @chainfusion/nextjs build",
    "next:check-types": "yarn workspace @chainfusion/nextjs check-types",
    "next:format": "yarn workspace @chainfusion/nextjs format",
    "next:lint": "yarn workspace @chainfusion/nextjs lint",
    "next:serve": "yarn workspace @chainfusion/nextjs serve",
    "precommit": "lint-staged",
    "start": "yarn workspace @chainfusion/nextjs dev",
    "test": "yarn hardhat:test",
    "vercel": "yarn workspace @chainfusion/nextjs vercel",
    "vercel:yolo": "yarn workspace @chainfusion/nextjs vercel:yolo",
    "verify": "yarn workspace @chainfusion/hardhat verify"
  },
  "devDependencies": {
    "husky": "~8.0.3",
    "lint-staged": "~13.2.2"
  },
  "packageManager": "yarn@3.2.3",
  "engines": {
    "node": ">=18.18.0"
  }
}
